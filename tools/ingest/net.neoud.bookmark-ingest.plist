<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.neoud.bookmark-ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/neoudhaile/.local/bin/neoud-bash</string>
    <string>/Users/neoudhaile/Documents/Projects/bookmark-ingestion/run.sh</string>
  </array>
  <key>WatchPaths</key>
  <array><string>/Users/neoudhaile/Downloads</string></array>
  <!-- WatchPaths cannot see a PR merged on GitHub, so also poll. run.sh exits on the
       cheap no-op guard when there is nothing queued, and the mkdir lock keeps a
       tick from colliding with a Downloads-triggered run, so this is near-free. -->
  <key>StartInterval</key><integer>1800</integer>
  <key>StandardOutPath</key><string>/tmp/neoud-ingest.log</string>
  <key>StandardErrorPath</key><string>/tmp/neoud-ingest.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/neoudhaile/.local/bin:/Users/neoudhaile/.nvm/versions/node/v20.20.2/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/neoudhaile</string>
  </dict>
</dict>
</plist>
